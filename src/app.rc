1 ICON "app.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 3,3,0,0
PRODUCTVERSION 3,3,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x00040004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ip-float"
            VALUE "FileDescription", "Exit IP floating card"
            VALUE "FileVersion", "3.3.0"
            VALUE "InternalName", "ip-float"
            VALUE "OriginalFilename", "ip-float.exe"
            VALUE "ProductName", "ip-float"
            VALUE "ProductVersion", "3.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
