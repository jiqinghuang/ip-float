# ── 编译中间产物 ─────────────────────────────────────────────
# build.ps1 用完会自己删掉 app.res.o，这里只是兜底
*.o
*.res.o

# ── 构建输出 / 测试产物 ──────────────────────────────────────
dist/
test_ipinfo.exe
ip-float.exe

# ── 运行时 / 自检产物 ────────────────────────────────────────
# 仅当 %APPDATA%\ip-float\ 不可写时才会生成这个便携回退配置
# （正常配置在 %APPDATA%\ip-float\settings.ini，不在仓库里）
ip-float.ini

# self-test 会在截图/渲染图旁边写一个同名 .log（-mwindows 没有控制台），
# --render 还会写 .json sidecar
*.png.log
*.png.json

# 右键「网络诊断…」/ --diag 的产物（写在 exe 旁边）
ip-float-diag.txt
ip-float-diag.json

# ── 签名证书 ─────────────────────────────────────────────────
# sign.ps1 -ExportCer 的产物；公钥证书不该顺手提交
*.cer

# ── 网站素材工具的产物（.site-assets/generate.py）─────────────
# build/ 是自检抓屏的原始截图，out/ 是处理后的网页素材；
# 两者都能用 generate.py 随时重新生成，真实副本在 jiqinghuang.github.io 仓库里
.site-assets/build/
.site-assets/out/

# ── 本地工具与系统垃圾 ───────────────────────────────────────
.claude/
.workbuddy/
.vscode/
Thumbs.db
.DS_Store
